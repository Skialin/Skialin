# Appended to args.gn on Windows hosts. Direct3D backs Ganesh D3D12; Dawn backs Graphite D3D12
# (Graphite has no native D3D12 backend of its own).
skia_use_metal = false
skia_use_direct3d = true
skia_use_dawn = true
# Static CRT, to match dawn_combined.lib: Skia's Dawn build script (third_party/dawn/cmake_utils.py)
# hard-codes /MT, and MSVC refuses to link /MT and /MD objects into one DLL. rust/.cargo/config.toml
# makes rustc (and so the cc-built shim) use the static CRT as well.
extra_cflags = [ "/MT" ]
